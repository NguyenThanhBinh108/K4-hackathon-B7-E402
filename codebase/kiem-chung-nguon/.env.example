# Copy file nay thanh ".env" (bo ".example") roi dien key that vao.
# File ".env" da nam trong .gitignore (*.env) nen se KHONG bi commit.
# KHONG bao gio dan key that vao file .env.example nay hay vao chat.

OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Bot Discord (bot.py) ---
DISCORD_BOT_TOKEN=
# Id server test cua nhom -> slash command hien ngay lap tuc thay vi cho ~1 gio.
# Bat Developer Mode trong Discord roi chuot phai vao server -> Copy Server ID.
DISCORD_GUILD_ID=

# --- Che do AUTO (tu dong quet moi tin nhan) ---
# DE TRONG = TAT. Bat len la bot doc noi dung tin nhan cua nguoi khac trong
# cac kenh nay -> CHI bat trong server test cua nhom, hoac trong server khoa
# khi DA XIN PHEP ban to chuc. Can bat them "Message Content Intent" trong
# Developer Portal. Nhieu kenh thi ngan cach bang dau phay.
AUTO_CHANNEL_IDS=
AUTO_MIN_LEN=80          # tin ngan hon bay nhieu ky tu thi bo qua
COOLDOWN_SECONDS=20      # moi nguoi toi da 1 luot / bay nhieu giay

# --- Duong dan transcript cho tinh nang "nen doc lai bai nao" ---
# Mac dinh tro toi data/vlearn-pack/transcript/ trong repo goc cua khoa.
# KHONG copy transcript vao repo nop bai — chi tro duong dan toi cho no dang nam.
TRANSCRIPT_DIR=
